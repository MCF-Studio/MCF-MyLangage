// Premier exemple MCF : point d'entrée, DualType, scopes et événements.

scope Player {
    name: String = "Alex";
    state: Bool, Int = true;

    func showState(_bonus: Int): Void {
        if (state is Int) then {
            print(state + _bonus);
        }
        else {
            print(state);
        }
    }
}

event PlayerConnected(_playerId: Int);

on PlayerConnected(_playerId) {
    print(_playerId);
}

// Point d'entrée du programme.
func main(): Void {
    Player.showState(10);
    emit PlayerConnected(1);
}
